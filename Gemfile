source "https://rubygems.org"

# GitHub Pages construye el sitio con esta gema, que fija las mismas versiones
# de Jekyll y plugins que usa el servidor de GitHub. Así lo que ves en local
# (si algún día instalas Ruby y compilas en tu máquina) es lo mismo que publica GitHub.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-sitemap"
  gem "jekyll-feed"
end

# Necesario en Windows/algunas instalaciones recientes de Ruby.
gem "webrick", "~> 1.8"
